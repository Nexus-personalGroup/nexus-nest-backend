# =============================================================================
# repo 根目錄的 .env.example —— **基礎設施設定**（容器對外開哪個埠、開發 DB 密碼）
# -----------------------------------------------------------------------------
# 複製成 `.env` 後即可調整：
#
#   cp .env.example .env
#
# **不複製也能跑**：下面每一行都是 compose 的內建預設值，沒有 `.env` 時
# compose 會用 `${VAR:-預設}` 的後半段。這份存在的目的是讓「有哪些可以調」
# 一眼看得到——否則要調埠的人得去讀 compose.yml。
#
# ── 與 apps/api/.env 的分工（最容易搞混的地方）──
#
#   本檔（根目錄）      compose 展開 `${...}` 時讀 → 「容器對外開哪個埠」
#   apps/api/.env       envSchema 讀 → 「應用程式要連到哪、在哪監聽」
#
# **改埠時兩份要成對改。** 例如 DEV_DB_PORT 改成 5443，
# `apps/api/.env` 的 DB_PORT 也要改成 5443，否則 host 模式的 api 連不到——
# 而錯誤訊息只會說 connection refused，指不到是哪一份沒改。
#
# **容器模式下 `apps/api/.env` 是被遮蔽的**（compose 掛 `docker/api.container.env`
# 蓋掉它，見 compose.yml 的 x-app-base），那時只有本檔有作用。
# =============================================================================

# ─── 對外埠 ───
# 全部綁 127.0.0.1（只給本機，不曝露到區網），且刻意避開 PostgreSQL 5432 /
# Redis 6379 的預設值——多數開發機已經有一組資料庫在跑，佔用預設埠會直接起不來。

# 容器模式的**唯一入口**（nginx）。api 與 web 刻意不發布對外埠；
# 要直連請改跑 host 模式（`pnpm docker:deps` + `pnpm dev`，那條路是 3000 / 5173）
APP_PROXY_PORT=8080

# 開發用 PostgreSQL / Redis（named volume，重啟保留資料）
DEV_DB_PORT=5442
DEV_REDIS_PORT=6389

# 驗證用 PostgreSQL（`--profile verify` / `e2e`，tmpfs、跑完即拋）。
# 與上面那組分開而非共用，是因為對資料的要求相反：
# 開發要重啟保留，驗證要每次乾淨。`pnpm verify:ci` 與 CI 都走這個埠
VERIFY_DB_PORT=15432

# ─── 開發資料庫 ───
# 只用於容器內 postgres 服務的初始化。**這不是正式環境的憑證**，
# 正式環境一律由部署平台注入
DEV_DB_DATABASE=nexus_db
DEV_DB_PASSWORD=devsecret
