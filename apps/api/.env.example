# =============================================================================
# apps/api 環境變數範本
# -----------------------------------------------------------------------------
# 複製為 .env 後填值。所有變數的型別與預設值由
# apps/api/src/infrastructure/validate-env.ts 的 envSchema 驗證——
# 新增變數一定要同時加進該 schema，否則執行期會靜默是 undefined。
#
# [必填] 標記者缺少會在啟動時 exit(1)。
#
# **Docker 開發不讀本檔對應的 .env**：compose.yml 用 docker/api.container.env
# 遮蔽容器內的 apps/api/.env，設定只有兩個來源——compose 的 environment
# 與 envSchema 的預設值。要在容器裡覆寫請改 docker/api.container.env。
# =============================================================================

# ─── 應用 ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=nexus-api
# API_BASE_URL=
# 單一埠部署用：前端打包產物根目錄；未設則相對 api 編譯輸出往上找 apps/web/dist
# WEB_STATIC_ROOT=

# 是否掛載 Swagger UI 與 OpenAPI spec。**未設定時依 NODE_ENV**：production 關、其餘開。
# /api/admin/docs-json 是一份完整的後台地圖（所有端點、參數 schema、錯誤碼、權限碼命名），
# 而它掛在 app.use() 上，全域 JwtAuthGuard 根本碰不到（Nest 的 guard 只作用於 Nest 路由）。
# 關閉不影響開發流程：swagger:check 與 api-client codegen 走的是本機檔案而非 HTTP 端點
# SWAGGER_ENABLED=

# ─── 資料庫（PostgreSQL）───
# 用 pnpm docker:deps 起容器時，對外埠是 5442（刻意避開預設 5432）
DB_HOST=127.0.0.1                      # [必填]
DB_PORT=5442
DB_USERNAME=postgres                   # [必填]
DB_PASSWORD=devsecret
DB_DATABASE=nexus_db                   # [必填]
# e2e 專用測試庫。**名稱必須含 test** —— globalSetup 會守門檢查，
# 防止誤把 dev / prod 庫清空。僅跑 e2e 時需要
DB_TEST_DATABASE=nexus_test

# ─── JWT ───
# 產生方式：openssl rand -hex 32
ACCESS_SECRET=                         # [必填] 至少 32 字元
REFRESH_SECRET=                        # [必填] 至少 32 字元
ACCESS_TOKEN_EXPIRES_IN=7200
REFRESH_TOKEN_EXPIRES_IN=604800
# issuer / audience：簽發與驗證需一致，避免 token 被共用同 secret 的其他服務重放
JWT_ISSUER=nexus-api
JWT_AUDIENCE=nexus-web
# SESSION_SECRET=                      # 選填，設了就要 >= 32 字元

# ─── Redis（**硬相依**，不是選填）───
# token 黑名單採 fail-closed：查不到就無法確認 token 是否已撤銷，一律回 503。
# 下面有預設值只是為了本機方便，不代表服務可以沒有 Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6389                        # docker:deps 的對外埠（避開預設 6379）
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nest:
REDIS_TTL=0
# REDIS_URL=

# ─── CORS / Cookie ───
# **不要設成 `*`**：CORS 規範下 origin=* 與 credentials:true 互斥，
# 瀏覽器會 silent reject 帶憑證的請求（production 也會擋）
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
COOKIE_SECRET=                         # [必填] 至少 32 字元

# ─── 檔案儲存 ───
STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=media
LOCAL_MEDIA_BASE_URL=/media
MAX_UPLOAD_BYTES=5242880
# 檔案 URL 的公開前綴。**即使 STORAGE_DRIVER=local 也必填**（給佔位值即可）
AWS_MEDIA_LIBRARY_ROOT=local           # [必填]

# ─── AWS S3（STORAGE_DRIVER=s3 時才需要）───
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ─── Firebase FCM（選填）───
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# ─── SMTP（選填，忘記密碼信件需要）───
# SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# ─── 安全參數 ───
# 生產環境強制 >= 12；本機用 10 換編譯與測試速度
BCRYPT_ROUNDS=10
# Express trust proxy：決定是否採信 X-Forwarded-For。
# 預設 loopback（只信本機）；部署在 LB / 反向代理後面改成信任跳數（如 1）或 proxy CIDR。
# **切勿用 true** —— 會無條件採信偽造的 XFF
TRUST_PROXY=loopback
COMMON_RATE_LIMIT_WINDOW_MS=60000
COMMON_RATE_LIMIT_MAX_REQUESTS=100
# Redis 掛掉時的節流策略。false = fail-closed（回 429）。
# 設 true 換可用性，代價是 Redis 一掛全站速率限制歸零，包含登入與 forgot-password
THROTTLE_FAIL_OPEN=false

# ─── 分頁與快取 ───
DEFAULT_PAGE_LIMIT=15
# 角色 / 權限變更最多延遲此秒數生效
PERMISSION_CACHE_TTL=300

# ─── 功能開關 ───
# 生產環境必須為 true，否則 RolesGuard 失效（@Roles 裝飾無作用）
APPLICATION_ADMIN_ROLE_ENABLED=true
APPLICATION_AUTH_LOG_ENABLED=false
APPLICATION_IP_WHITELIST_ENABLED=false
APPLICATION_IP_BLACKLIST_ENABLED=false
APPLICATION_ACCOUNT_LOCK_ENABLED=false
APPLICATION_PASSWORD_CHANGE_ENABLED=false
APPLICATION_SESSION_IDLE_ENABLED=false
APPLICATION_GOOGLE_RECAPTCHA_ENABLED=false
APPLICATION_API_LOG_ENABLED=false
APPLICATION_OPERATION_LOG_ENABLED=false

# ─── 日誌保留排程（預設啟用）───
# system_logs 在 API log 開啟時每個請求寫一筆且完整存 request/response，
# 沒有保留策略會無界成長，而這兩張表目前只寫不讀。關掉前請確認有別的清理機制
LOG_PURGE_ENABLED=true
LOG_RETENTION_DAYS=90
LOG_PURGE_CRON=0 0 3 * * *

# ─── 可觀測性（預設關閉）───
APPLICATION_SENTRY_ENABLED=false
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APPLICATION_METRICS_ENABLED=false

# ─── 密碼策略 ───
APPLICATION_PASSWORD_MIN_LENGTH=8
APPLICATION_PASSWORD_MAX_LENGTH=32
# 複雜度 0–4
APPLICATION_SYSTEM_ADMIN_PASSWORD_COMPLEXITY=4
APPLICATION_OTHER_ADMIN_PASSWORD_COMPLEXITY=1
# 密碼有效月數，0 = 不過期
APPLICATION_PASSWORD_CHANGE_PERIOD=6
APPLICATION_IS_LOGOUT_AFTER_PASSWORD_RESET=false

# ─── 帳號鎖定 ───
APPLICATION_ACCOUNT_LOCK_THRESHOLD=3
APPLICATION_IP_BLOCK_THRESHOLD=5

# 鎖定的時效（分鐘）。**沒有時效的鎖定是一個沒有復原路徑的死結**：
# 鎖定的檢查排在密碼驗證之前，被鎖的帳號連「密碼打對」都到不了清除計數那條路；
# 而人工解鎖的端點需要一個已登入且具 SUPERADMIN 的管理員——
# 把已知的管理員 email 全鎖一輪就沒有人能登入解鎖，而觸發鎖定完全不需要認證。
# 時效不解決「持續攻擊者可以每 N 分鐘重鎖一次」，那是 APPLICATION_IP_BLOCK_THRESHOLD 的職責
APPLICATION_ACCOUNT_LOCK_DURATION_MIN=15

# ─── 閒置自動登出（分鐘）───
APPLICATION_SESSION_IDLE_TIMEOUT=120

# ─── 密碼重設 ───
# token 有效分鐘數
APP_PASSWORD_RESET_TOKEN_EXPIRES_IN=30
# APP_PASSWORD_RESET_URL=

# ─── Google reCAPTCHA（選填）───
# GOOGLE_RECAPTCHA_SECRET=
# GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_VERSION=v2
GOOGLE_RECAPTCHA_IS_PRODUCTION=false

# ─── Seed 預設帳號 ───
ADMIN_DEFAULT_EMAIL=admin@test.com
ADMIN_DEFAULT_PASSWORD=Admin1234!
# seed-runner 的生產環境擋關，語意是「有設值即放行」。正式環境才需要
# ALLOW_PROD_SEED=

# ─── 時區 ───
# 生產環境必填。IANA 時區名稱，會被 Intl 驗證
APP_TIMEZONE=Asia/Taipei

# ─── WebSocket ───
# 連線的心跳間隔（秒）。presence 靠它續期，太稀疏會讓實例死亡留下的紀錄存活更久
WS_HEARTBEAT_INTERVAL=15
# 陳舊判定倍數：超過「心跳間隔 × 此值」未更新的連線視為已失效。
# 這是唯一能自動回收「實例被強制終止」所留紀錄的機制。**不能設 1**——
# 單次心跳因網路抖動延遲就會誤判在線使用者為離線
WS_STALE_MULTIPLIER=3
# 離線廣播延遲（秒）。使用者斷線後不立即廣播離線，等這段時間確認沒有重連。
# 沒有這段延遲時，一次換頁或短暫斷網會讓聯絡人看到「離線→上線」跳動
WS_OFFLINE_BROADCAST_DELAY=5
# 單一成員允許的同時連線數上限（多裝置、多分頁），超過時拒絕最新的連線
WS_MAX_CONNECTIONS_PER_MEMBER=10
# 送訊息限流：每人每房間每 WS_MESSAGE_RATE_WINDOW_SEC 秒最多 WS_MESSAGE_RATE_LIMIT 則
WS_MESSAGE_RATE_LIMIT=20
WS_MESSAGE_RATE_WINDOW_SEC=10
# 連線層事件限流：單一 WebSocket 連線每 WS_CONNECTION_EVENT_WINDOW_SEC 秒
# 最多 WS_CONNECTION_EVENT_LIMIT 個事件（**含 ping，沒有例外清單**）。
# 與 WS_MESSAGE_RATE_* 是兩道獨立防線，互相取代不了：
# 這一道護的是本行程的事件迴圈（計數單位是單一連線，開 N 條就有 N 倍額度），
# 那一道護的是房間不被洗版（計數單位是成員 + 房間，跨連線跨實例）。
# 門檻刻意設在遠高於任何合理客戶端的水準——它是「明顯失控」的界線而非精細控制
WS_CONNECTION_EVENT_LIMIT=20
WS_CONNECTION_EVENT_WINDOW_SEC=1

# ─── 通知排程 ───
NOTIFICATION_ALARM_HOUR=8
NOTIFICATION_ALARM_MINUTE=0

# ─── 範例排程（預設關閉）───
SCHEDULE_ENABLED=false
SCHEDULE_EXAMPLE_CRON=0 * * * * *

# ─── 訊息可撤回的時限（秒）；預設 5 分鐘 ───
CHAT_RETRACT_WINDOW_SEC=300

# 聊天行為稽核（與指標開關分開；關掉會讓日後的檢舉調查沒有依據）
CHAT_AUDIT_ENABLED=true

# 聊天資料保留（與 LOG_* 刻意分開：稽核關掉會讓日後的調查沒有依據）
CHAT_RETENTION_ENABLED=true
CHAT_AUDIT_RETENTION_DAYS=180
CHAT_REPORT_RETENTION_DAYS=365
CHAT_RETENTION_CRON=0 30 3 * * *

# ─── 營運總覽 ───
# SSE 的推送間隔（秒）。查詢是**實例級**的：實例上有 1 個或 10 個管理員在看，
# 資料庫的查詢次數都一樣，所以這個值決定的是「每個實例每秒幾次查詢」而非「每人幾次」
DASHBOARD_STREAM_INTERVAL_SEC=5
