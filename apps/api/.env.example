# =============================================================================
# apps/api 環境變數
# -----------------------------------------------------------------------------
# 標記說明：
#   [必填]  未設定則啟動時 exit(1)（共 7 個）
#   [prod]  NODE_ENV=production 時有額外檢查，不符也 exit(1)
#   其餘皆有預設值，可整段留空
#
# 全部變數都必須宣告在 src/infrastructure/validate-env.ts 的 envSchema——
# 沒宣告的會靜默變成 undefined，架構測試會擋下這種情況。
# =============================================================================

# ─── 應用基本 ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=nexus-api
API_BASE_URL=http://localhost:3000
# [prod] 生產環境必填（例：Asia/Taipei）。DB 一律存 UTC，此值只影響顯示層格式化
APP_TIMEZONE=Asia/Taipei
# 單一埠部署用：前端打包產物根目錄。未設則相對 api 編譯輸出往上找 apps/web/dist；
# 找不到就略過靜態掛載（純 API 部署不受影響）
WEB_STATIC_ROOT=

# ─── 資料庫 ───
DB_HOST=localhost                       # [必填]
DB_PORT=3306
DB_USERNAME=root                        # [必填]
DB_PASSWORD=                            # [prod] 生產環境不允許空密碼
DB_DATABASE=hexagonal_express_db        # [必填]
# e2e 專用測試庫，名稱**必須含 test**（globalSetup 會守門，防誤連 / 誤清 dev、prod 庫）
DB_TEST_DATABASE=hexagonal_express_test_db
# 不需要設 DATABASE_URL：應用啟動時由 PrismaService 以上面的 DB_* 組裝物件組態。
# 僅 Prisma CLI（migrate / studio）需要，已由 scripts/prisma-env.ts 自動組出並注入。

# ─── JWT / Session ───
# 產生 secret：openssl rand -hex 32
ACCESS_SECRET=                          # [必填][prod] 至少 32 字元，不可含預設佔位字串
REFRESH_SECRET=                         # [必填][prod] 至少 32 字元，且**不可與 ACCESS_SECRET 相同**
COOKIE_SECRET=                          # [必填][prod] 至少 32 字元
SESSION_SECRET=                         # 選填；留空視為未設定
ACCESS_TOKEN_EXPIRES_IN=7200            # 秒（2 小時）
REFRESH_TOKEN_EXPIRES_IN=604800         # 秒（7 天）
# 簽發與驗證共用，避免 token 被同 secret 的其他服務重放。
# 注意：改動屬破壞性變更：既有已簽發的 token 全部失效，部署後所有人須重新登入
JWT_ISSUER=hexagonal-api
JWT_AUDIENCE=hexagonal-web

# ─── Redis ───
# 注意：REDIS_URL 優先於 REDIS_HOST / REDIS_PORT——兩者都填時 HOST/PORT 會被忽略。
# 用雲端 Redis（Redis Cloud、Heroku 等）填 REDIS_URL；本機開發建議只留 HOST/PORT、
# 把 REDIS_URL 留空，否則改了 HOST 卻沒效果會很難查。
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nest:
REDIS_TTL=0                             # 0 = 不設全域 TTL；黑名單與 MemberContext 快取各自帶 TTL

# ─── CORS / 反向代理 ───
# 多個 origin 以逗號分隔；dev 需同時允許後端與 Vite dev server
CORS_ORIGIN=http://localhost:3000,http://localhost:5173   # [prod] 不允許 '*'
# request.ip 是否採信 X-Forwarded-For。'loopback' = 只信本機（安全預設）；
# 部署在 LB / 反向代理後改成信任跳數（如 '1'）或具體 CIDR。
# 注意：切勿設 'true'——會無條件採信偽造的 XFF，使 IP 黑名單失效、登入失敗封鎖失準
TRUST_PROXY=loopback

# ─── 密碼與加密 ───
BCRYPT_ROUNDS=10                        # [prod] 生產環境必須 ≥ 12
# 複雜度等級是**累加**的（設 3 等於同時要求 1 與 2 的條件）：
#   0 = 只檢查長度
#   1 = + 至少一個英文字母、一個數字
#   2 = + 大小寫各至少一個
#   3 = + 至少一個特殊符號
#   4 = + 不可包含常見弱密碼字串（admin、password 等）
APPLICATION_PASSWORD_MIN_LENGTH=8
APPLICATION_PASSWORD_MAX_LENGTH=32
APPLICATION_SYSTEM_ADMIN_PASSWORD_COMPLEXITY=4    # 系統管理員（預設最嚴）
APPLICATION_OTHER_ADMIN_PASSWORD_COMPLEXITY=1     # 一般後台帳號
APPLICATION_PASSWORD_CHANGE_PERIOD=6              # 月；需搭配 APPLICATION_PASSWORD_CHANGE_ENABLED=true
APPLICATION_IS_LOGOUT_AFTER_PASSWORD_RESET=false
APP_PASSWORD_RESET_TOKEN_EXPIRES_IN=30            # 分鐘
APP_PASSWORD_RESET_URL=                           # 重設密碼信中的前端頁面網址

# ─── 檔案儲存 ───
# driver 決定用哪一組設定：
#   local → 用下方 LOCAL_MEDIA_*，寫本機磁碟，免 AWS（dev / 衍生專案預設）
#   s3    → 用 AWS_* 那組，走 S3 + presigned URL
STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=media                  # 落地目錄（相對 cwd）
LOCAL_MEDIA_BASE_URL=/media             # 對外服務的 URL 前綴
MAX_UPLOAD_BYTES=5242880                # 單檔上限（bytes），預設 5MB
# 注意：AWS_MEDIA_LIBRARY_ROOT 是 [必填]，即使用 local driver 也要有值（給個佔位即可）。
# 它只在 s3 driver 下有作用：作為回傳檔案 URL 的公開前綴。
AWS_MEDIA_LIBRARY_ROOT=local
# 以下僅 STORAGE_DRIVER=s3 時需要
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── Email SMTP ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                       # true = 直接走 TLS（通常配 port 465）
SMTP_USER=
SMTP_PASS=
# 格式為 email 的 display-name 標準寫法，引號與角括號都會保留
EMAIL_FROM="NestJS App" <noreply@example.com>

# ─── 功能開關（Feature Flags，預設全關）───
# 每個開關控制一整組行為；關閉時相關 guard / 攔截器完全不生效。
# 注意：APPLICATION_ADMIN_ROLE_ENABLED 關閉會讓 RolesGuard 一律放行——所有 @Roles 端點
#   （IP 黑白名單、帳號解鎖等）對任何已登入者開放。生產環境由 validate-env 強制為 true。
APPLICATION_ADMIN_ROLE_ENABLED=true
APPLICATION_AUTH_LOG_ENABLED=false          # 登入 / 登出 / 密碼重設寫入 auth_logs
APPLICATION_API_LOG_ENABLED=false           # LoggingInterceptor 寫 system log
APPLICATION_OPERATION_LOG_ENABLED=false     # 操作日誌
APPLICATION_IP_WHITELIST_ENABLED=false      # 開啟後「只有」白名單 IP 能存取
APPLICATION_IP_BLACKLIST_ENABLED=false      # 黑名單 + 登入失敗自動封鎖
APPLICATION_ACCOUNT_LOCK_ENABLED=false      # 登入失敗計數 + 鎖定帳號
APPLICATION_PASSWORD_CHANGE_ENABLED=false   # 密碼過期強制更換（配 PASSWORD_CHANGE_PERIOD）
APPLICATION_SESSION_IDLE_ENABLED=false      # 閒置自動登出（配 SESSION_IDLE_TIMEOUT）
APPLICATION_GOOGLE_RECAPTCHA_ENABLED=false  # 登入時驗證 reCAPTCHA（配下方 GOOGLE_RECAPTCHA_*）

# 上面幾個開關的搭配參數
APPLICATION_ACCOUNT_LOCK_THRESHOLD=3        # 連續失敗幾次鎖帳號
APPLICATION_IP_BLOCK_THRESHOLD=5            # 連續失敗幾次封 IP
APPLICATION_SESSION_IDLE_TIMEOUT=120        # 分鐘

# ─── Google reCAPTCHA（需 APPLICATION_GOOGLE_RECAPTCHA_ENABLED=true 才生效）───
# 下方預設值是 Google 官方的「永遠通過」測試金鑰，正式環境務必換掉
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
GOOGLE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_VERSION=v2
GOOGLE_RECAPTCHA_IS_PRODUCTION=false

# ─── 可觀測性（兩者都預設關閉）───
# Sentry：需要 flag=true **且** DSN 有值才會送出事件（少一個都是 no-op）
APPLICATION_SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0             # 0~1；production 視流量調到 0.1 左右
# Prometheus：開啟後曝露 GET /api/metrics（含 Node / process 指標）
# 注意：該端點沒有應用層認證，只受全域 IP 黑白名單保護。生產環境開啟時務必在反向代理或
#    網路層限制來源（只允許內網 / Prometheus scraper），勿對外公開
APPLICATION_METRICS_ENABLED=false

# ─── Firebase FCM（推播；未設定時啟動只會印 debug 訊息，不影響其他功能）───
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── 排程（@nestjs/schedule）───
# 注意：cron 表達式必須在 onModuleInit 動態註冊，不能寫在 @Cron() decorator——
#    decorator 的參數在模組載入時就求值，那時 dotenv 還沒跑，會讀到 undefined
SCHEDULE_ENABLED=false
SCHEDULE_EXAMPLE_CRON=0 * * * * *       # 6 欄位（含秒），預設每分鐘的第 0 秒
# 目前尚無程式消費這兩個值，保留給後續的通知排程使用
NOTIFICATION_ALARM_HOUR=8
NOTIFICATION_ALARM_MINUTE=0

# ─── 速率限制（全域 ThrottlerGuard）───
# 這是全域預設；forgot-password / reset-password 另有更嚴格的 per-route @Throttle
COMMON_RATE_LIMIT_WINDOW_MS=60000       # 計算視窗（毫秒），預設 1 分鐘
COMMON_RATE_LIMIT_MAX_REQUESTS=100      # 視窗內每 IP 允許的請求數

# ─── 其他 ───
PERMISSION_CACHE_TTL=300                # 秒；權限快取，改角色 / 停用帳號後最長延遲此秒數生效
DEFAULT_PAGE_LIMIT=10                   # 列表 API 未指定 limit 時的預設值

# ─── Seed ───
ADMIN_DEFAULT_EMAIL=admin@test.com
ADMIN_DEFAULT_PASSWORD=Admin1234!
# 生產環境的 seed 擋關：NODE_ENV=production 時，未設此值就拒絕執行 db:seed。
# 語意是「有設值即放行」（設 1 即可），不是 true/false 判斷
ALLOW_PROD_SEED=
