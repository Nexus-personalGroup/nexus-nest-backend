generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 所有 DateTime 一律標 @db.Timestamptz(3)：UTC 保證放在欄位層而非 driver 設定。
// 用不帶時區的 timestamp 時，pg driver 會以「Node 行程的本機時區」解析，
// CI（UTC）與開發機（Asia/Taipei）會靜默相差 8 小時且不報錯。
//
// 欄位的 `///` 註解會進 Prisma Client 的 JSDoc，但**不會進資料庫**。
// migration 末尾另有一段 COMMENT ON COLUMN 把同樣的描述寫進 PostgreSQL，
// 讓 psql \d+、DBeaver 與直接查庫的人也看得到。兩邊改動要一起。

/// HTTP 請求稽核紀錄。由全域 interceptor 寫入，涵蓋所有進到 API 的請求
model SystemLogRecord {
  id String @id @default(uuid())

  /// 發動請求的帳號。未登入請求（登入、忘記密碼等）為 null，故不建外鍵也不可當必填關聯鍵
  memberId String? @map("member_id")

  /// 業務動作代碼，供「某帳號做過哪些操作」的彙總查詢；由路由推導而非使用者輸入
  action String

  /// 來源 IP。已依 TRUST_PROXY 設定解析出真實客戶端位址，不是 proxy 的位址
  ipAddress String? @map("ip_address")

  /// HTTP 方法
  method String?

  /// 完整請求路徑（含 query string）
  url String?

  /// 請求內容的 JSON 字串。敏感鍵已由 sanitize 以子字串比對遮蔽（password / newPassword 等變形一併涵蓋）
  request String?

  /// 回應內容的 JSON 字串，同樣經過遮蔽
  response String?

  /// 回應的 HTTP 狀態碼
  statusCode Int? @map("status_code")

  /// 處理耗時（毫秒），用於抓出慢請求
  execTime Float? @map("exec_time")

  /// 請求進入時間。與 responseTime 分開存而非只存耗時，是為了能重建完整時間軸
  requestTime DateTime @map("request_time") @db.Timestamptz(3)

  /// 回應送出時間
  responseTime DateTime @map("response_time") @db.Timestamptz(3)

  /// 寫入時間。日誌保留排程以此欄位為界分批刪除，故必須有索引
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // 保留排程以 createdAt 為條件批次刪除，沒有索引會全表掃描；
  // memberId 複合索引供日後查「某帳號的操作紀錄」
  @@index([createdAt], map: "idx_system_logs_created")
  @@index([memberId, createdAt], map: "idx_system_logs_member_created")
  @@map("system_logs")
}

/// 角色。權限的授予單位，成員透過角色取得權限而非直接掛權限
model Role {
  id String @id @default(uuid())

  /// 角色顯示名稱，唯一。僅供顯示，程式判斷一律用 roleCode
  name String @unique @db.VarChar(100)

  /// 啟用狀態。停用後不能再指派給新成員，但既有持有者不受影響
  status Boolean @default(true)

  /// 程式判斷用的穩定代碼（如 SUPERADMIN）。與顯示名稱解耦，改名不影響授權邏輯
  roleCode String? @map("role_code") @db.VarChar(50)

  /// 系統預設角色，不可刪除。新建成員未指定角色時落到這一個
  isDefault Boolean @default(false) @map("is_default")

  /// 建立者的成員 ID。稽核用途，刻意不建外鍵——刪除帳號時不應被稽核紀錄卡住
  createdBy String? @map("created_by") @db.VarChar(36)

  /// 最後修改者的成員 ID，同樣不建外鍵
  updatedBy String? @map("updated_by") @db.VarChar(36)

  members     MemberRecord[]
  permissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// 軟刪除標記。所有查詢必須帶 deletedAt: null，漏帶會撈出已刪除的角色
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("roles")
}

/// 權限項目。由 seed 定義，不開放後台新增——新增權限意味著程式碼要有對應的檢查點
model Permission {
  id String @id @default(uuid())

  /// 權限碼，格式 `PLATFORM:MODULE:ACTION`（如 `BACKEND:MEMBER:EDIT`）。程式以此字串比對，是唯一的判斷依據
  permissionCode String @unique @map("permission_code")

  /// 權限的顯示名稱，僅供後台權限樹呈現
  name String

  /// 權限適用面："FRONTEND" | "BACKEND"
  platform String

  /// 所屬模組，供後台權限樹的第一層分組
  module String

  /// 子模組，供權限樹的第二層分組；無子分組時為 null
  subModule String? @map("sub_module")

  /// 動作類型："VIEW"（讀） | "EDIT"（寫） | "ACCESS"（進入）
  action String

  /// 啟用狀態。停用的權限不會出現在後台權限樹，也不會通過授權檢查
  status Boolean @default(true)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permissions")
}

/// 角色與權限的多對多關聯。整組覆寫而非增量更新——授權變更要能一次看出最終狀態
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// 授予時間，供「這個角色何時拿到這個權限」的稽核
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// 後台成員的持久化模型
///
/// 只存在於 adapter/out/persistence 層，與 domain 的 Member 完全分離——
/// 兩者透過 MemberMapper 轉換，資料庫欄位變動不會直接穿透到領域模型
model MemberRecord {
  id String @id @default(uuid())

  /// 成員顯示名稱
  member String @db.VarChar(100)

  /// bcrypt 雜湊後的密碼。輪數由 BCRYPT_ROUNDS 控制，生產環境強制 >= 12
  password String @db.VarChar(255)

  /// 登入帳號，唯一
  email String @unique @db.VarChar(255)

  /// 所屬角色。一個成員只能有一個角色，權限完全由角色決定
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  /// 啟用狀態。false 時登入直接拒絕，且既有 token 在下次請求即失效
  status Boolean @default(true)

  /// 系統預設帳號，不可刪除
  isDefault Boolean @default(false) @map("is_default")

  /// 連續登入失敗次數。達門檻觸發鎖定；登入成功或管理員解鎖時歸零
  failedLoginCount Int @default(0) @map("failed_login_count")

  /// JWT 失效世代
  ///
  /// JwtAuthGuard 每次請求比對 token 內的版本與此欄位現值，不符即拒絕。
  /// 改密碼、強制登出、refresh token 重用連坐撤銷時 +1——
  /// 這是「立即讓該帳號所有裝置的既發 token 失效」的唯一機制
  tokenVersion Int @default(0) @map("token_version")

  /// 帳號鎖定的起算時間。null 表示未鎖定
  ///
  /// 用時間戳而非布林旗標，才能算出「還剩多久自動解鎖」；解鎖是清成 null
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(3)

  /// 最後一次變更密碼的時間，供密碼到期策略計算下次強制更換日
  lastPasswordChange DateTime? @map("last_password_change") @db.Timestamptz(3)

  /// 建立者的成員 ID，稽核用，不建外鍵
  createdBy String? @map("created_by") @db.VarChar(36)

  /// 最後修改者的成員 ID，不建外鍵
  updatedBy String? @map("updated_by") @db.VarChar(36)

  /// 最後一次登入成功的時間。判斷閒置帳號用
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// 軟刪除標記。所有查詢必須帶 deletedAt: null
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("members")
}

/// 認證事件稽核。與 system_logs 分開，因為登入失敗的查詢頻率與保留需求都不同
model AuthLogRecord {
  id String @id @default(uuid())

  /// 對應的成員 ID。帳號不存在的登入嘗試為 null
  memberId String? @map("member_id")

  /// 被嘗試的登入帳號
  ///
  /// 刻意與 memberId 並存：登入失敗時可能查無此帳號、memberId 為 null，
  /// 但稽核仍必須知道「有人在試哪個 email」——這正是偵測撞庫的依據
  email String

  /// 事件類型：LOGIN_SUCCESS | LOGIN_FAILURE | LOGOUT | PASSWORD_RESET | REFRESH
  action String

  /// 來源 IP，已依 TRUST_PROXY 解析
  ipAddress String? @map("ip_address")

  /// 瀏覽器 UA 字串，供辨識異常裝置
  userAgent String? @map("user_agent")

  /// 補充說明，如失敗原因。MUST NOT 寫入密碼或 token
  detail String?

  /// 事件時間。保留排程以此為界分批刪除
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // email 複合索引供「某帳號的登入失敗紀錄」這類稽核查詢
  @@index([createdAt], map: "idx_auth_logs_created")
  @@index([email, createdAt], map: "idx_auth_logs_email_created")
  @@index([memberId, createdAt], map: "idx_auth_logs_member_created")
  @@map("auth_logs")
}

/// IP 白名單。設定後僅允許名單內的 IP 存取後台
model IpWhitelistRecord {
  id String @id @default(uuid())

  /// 允許的 IP 位址，唯一
  ipAddress String @unique @map("ip_address")

  /// 用途說明，供管理員辨識這條規則為何存在
  description String?

  /// 新增者的成員 ID
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("ip_whitelist")
}

/// IP 黑名單。名單內的 IP 一律拒絕，且 Redis 不可用時採 fail-closed
model IpBlacklistRecord {
  id String @id @default(uuid())

  /// 封鎖的 IP 位址，唯一
  ipAddress String @unique @map("ip_address")

  /// 封鎖原因
  reason String?

  /// 是否為系統自動封鎖（相對於管理員手動加入）
  ///
  /// 兩者的處置不同：自動封鎖可由排程或條件解除，手動封鎖只能由管理員移除
  isAutoBlock Boolean @default(false) @map("is_auto_block")

  /// 新增者的成員 ID。自動封鎖時為 null
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("ip_blacklist")
}

/// 密碼重設 token
model PasswordResetTokenRecord {
  id String @id @default(uuid())

  /// 申請重設的成員 ID
  memberId String @map("member_id")

  /// token 的 **sha256 雜湊**，不是明文
  ///
  /// 寄給使用者的是明文，資料庫只留雜湊——資料庫外洩不等於可以重設任何人的密碼。
  /// token 本身是高熵隨機值，單向雜湊即足夠，不需要 bcrypt 的加鹽與慢雜湊
  token String @unique

  /// 失效時間。過期的 token 由排程依此欄位清理
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// 使用時間。非 null 即代表已作廢
  ///
  /// 使用後保留紀錄而非刪除，才查得到「這個 token 何時被誰用掉」
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // 供「重設密碼時作廢該使用者其他 token」與過期 token 清理
  @@index([memberId], map: "idx_password_reset_member")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

/// 上傳檔案的中繼資料。實體檔案存在 local 或 S3，由 STORAGE_DRIVER 決定
model AttachmentRecord {
  id String @id @default(uuid())

  /// 原始檔案名稱。存入前已做 latin1→UTF-8 轉換，否則中文檔名會變亂碼
  fileName String @map("file_name") @db.VarChar(255)

  /// 檔案的公開存取 URL，前綴由 AWS_MEDIA_LIBRARY_ROOT 決定
  fileUrl String @map("file_url") @db.VarChar(500)

  /// MIME 類型。上傳時已用 magic byte（sniffMime）比對實際內容，與宣告不符會被拒絕
  fileType String @map("file_type") @db.VarChar(50)

  /// 檔案大小（bytes）
  fileSize Int @map("file_size")

  /// 關聯的資料表名稱。多型關聯的一半，刻意不建外鍵
  relatedTable String @map("related_table") @db.VarChar(50)

  /// 關聯的資料列 ID。與 relatedTable 合為複合索引，供「某筆資料的所有附件」查詢
  relatedId String @map("related_id") @db.VarChar(36)

  /// 上傳者的成員 ID
  ///
  /// 刪除時的擁有者檢查依據：非上傳者只有 SUPERADMIN 能刪。
  /// 少了這個欄位，任何持有 ATTACHMENT:EDIT 的帳號都能刪掉別人的附件（IDOR）
  uploadedBy String? @map("uploaded_by") @db.VarChar(36)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([relatedTable, relatedId], map: "idx_related")
  @@index([uploadedBy], map: "idx_uploaded_by")
  @@map("attachments")
}

/// seed 執行紀錄。seed-runner 據此跳過已跑過的檔案，使 db:seed 可重複執行
model SeedHistoryRecord {
  /// 自增主鍵。這張表不對外，不需要 UUID
  id Int @id @default(autoincrement())

  /// 已執行的 seed 檔名，唯一。檔名帶 timestamp 前綴以確保執行順序
  seedName String @unique @map("seed_name") @db.VarChar(255)

  /// 執行完成時間
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(3)

  @@index([seedName], map: "idx_seed_name")
  @@map("seed_history")
}

/// 房間類型。用 DB enum 而非字串欄位：非法值在寫入時就被擋掉，
/// 讀取端也不必把 string 轉回聯集型別（那個轉換只能靠斷言，等於騙過型別檢查）
enum RoomType {
  DIRECT
  GROUP

  @@map("room_type")
}

/// 聊天室。1:1 私聊與群組共用同一張表，以 roomType 區分
model ChatRoomRecord {
  id String @id @default(uuid())

  /// 房間類型：DIRECT（1:1 私聊）| GROUP（群組）
  roomType RoomType @map("room_type")

  /// 群組名稱。私聊為 null——它的顯示名稱由對方決定，存下來會在對方改名時過時
  name String? @db.VarChar(100)

  /// 1:1 私聊的正規化鍵：兩個成員 ID 排序後以冒號串接（`min:max`），群組為 null
  ///
  /// **這是「同一組人只能有一個私聊房間」的唯一保證來源。** 用「先查有沒有」實作
  /// 會有競態——兩邊同時開啟對話就建出兩個房間，而症狀是訊息分裂在兩個房間，
  /// 很難察覺。Postgres 的 unique index 允許多個 null，因此群組不會互相衝突。
  directKey String? @unique @map("direct_key") @db.VarChar(80)

  /// 建立者的成員 ID。稽核用途，不建外鍵——刪除帳號時不應被卡住
  createdBy String? @map("created_by") @db.VarChar(36)

  members  ChatRoomMemberRecord[]
  messages ChatMessageRecord[]
  reads    ChatRoomReadRecord[]

  /// 房間內已配出的最大訊息序號。寫訊息時在同一交易內 +1 並回填到訊息列
  ///
  /// 放在房間上而非用資料庫 sequence：一個房間一個 sequence 代表房間數等於 schema
  /// 物件數，建房間會變成 DDL 操作，而 DDL 不能安全地跟 DML 放進同一個交易
  lastSeq Int @default(0) @map("last_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chat_rooms")
}

/// 房間成員關係
///
/// **不做軟刪除**：離開房間即刪除該列。軟刪除的價值在「需要還原」或「需要歷史」，
/// 而重新加入就是建立新的關係、不需還原；歷史由稽核紀錄負責（M3）。
/// 代價面則相反——成員關係是每次授權判斷都要查的高頻路徑，
/// 少一個「所有查詢都要記得加」的條件是實質的簡化。
model ChatRoomMemberRecord {
  roomId String         @map("room_id")
  room   ChatRoomRecord @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// 成員 ID。不建外鍵至 members：帳號刪除的處置屬於業務決定，不該由 DB 層連動
  memberId String @map("member_id")

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  // memberId 索引供「我的房間列表」；主鍵本身涵蓋 (roomId, memberId) 的授權判斷
  @@id([roomId, memberId])
  @@index([memberId], map: "idx_chat_room_members_member")
  @@map("chat_room_members")
}

/// 聊天訊息
///
/// 順序由 seq 決定而非時間戳：兩個實例可能在同一毫秒寫入，
/// 而不同客戶端各自依時間排序會得到不同結果。順序必須由伺服器決定並固定下來
model ChatMessageRecord {
  id String @id @default(uuid())

  roomId String         @map("room_id")
  room   ChatRoomRecord @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// 發送者的成員 ID。不建外鍵至 members：帳號刪除的處置屬於業務決定，不該由 DB 層連動
  senderId String @map("sender_id")

  /// 訊息內容。目前只有純文字；日後的附件訊息會加 messageType 欄位，本欄不需改為可空
  ///
  /// **撤回不會清空本欄**：內容保留供 M3 的檢舉調查（騷擾者送完立即撤回是最典型的
  /// 行為，清掉等於提供一鍵銷毀證據），但任何前台路徑都不得回傳它。
  /// 遮蔽只寫在 repository 的投影函式一處，並有守則限制訊息表只能有一個查詢入口
  content String @db.Text

  /// 房間內單調遞增的序號，由 chat_rooms.last_seq 配號而來
  ///
  /// **這是訊息順序與斷線補齊的唯一依據。** 補齊時客戶端問「seq 大於 N 的都給我」，
  /// 因此房間內必須連續——撤回訊息時只能軟刪除、保留該列，
  /// 否則序號會出現洞，客戶端無法區分「被撤回」與「我漏收了」
  seq Int

  /// 客戶端在首次送出前產生的識別碼，重試時沿用同一個值
  ///
  /// 與 room_id 的複合唯一索引是去重的唯一保證來源。用「先查有沒有」會有空窗——
  /// 重試通常在數百毫秒內、且兩次請求可能落在不同實例上，症狀是聊天室裡偶爾出現
  /// 重複訊息，而且事後無法從伺服器端修復（兩列都是合法資料，分不出哪列是重送）
  clientMessageId String @map("client_message_id") @db.VarChar(64)

  /// 撤回時間；null 代表未撤回
  ///
  /// **這一列永遠不會被刪除。** 刪掉會讓 seq 出現洞，而補齊的客戶端無法區分
  /// 「這個號碼被撤回了」與「我漏收了」——後者會讓它反覆嘗試補齊同一段區間
  retractedAt DateTime? @map("retracted_at") @db.Timestamptz(3)

  /// 執行撤回的成員 ID。僅限發送者本人——管理員的移除走 removed_by，兩者不共用
  retractedBy String? @map("retracted_by")

  /// 管理員移除的時間；null 代表未被移除
  ///
  /// **刻意不與 retracted_at 共用。** 兩者對客戶端的語意不同：
  /// 「對方自己收回」與「被平台處理」。共用會讓發送者以為自己撤回了（他沒有），
  /// 也讓後台無法統計「被移除幾則」——而那是判斷平台治理狀況的基本指標。
  ///
  /// 兩個標記可以同時存在（撤回後仍可被移除），呈現上以移除優先——它是更強的宣告。
  /// 移除同樣是軟刪除：被移除的訊息正是最需要留下證據的那些
  removedAt DateTime? @map("removed_at") @db.Timestamptz(3)

  /// 執行移除的管理員 ID。不建外鍵：稽核性質的欄位要能在帳號被刪除後仍然存在
  removedBy String? @map("removed_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // (room_id, seq) 同時是唯一性保證與查詢索引：唯一性讓配號的錯誤在寫入當下就爆，
  // 而不是靜默產生重號；查詢面則涵蓋補齊與歷史查詢（都是「某房間、seq 大於／小於 N」）
  @@unique([roomId, seq], map: "uq_chat_messages_room_seq")
  @@unique([roomId, clientMessageId], map: "uq_chat_messages_room_client_id")
  @@map("chat_messages")
}

/// 每人每房間的已讀位置
///
/// 只記最後讀到的 seq，不記「哪幾則已讀」——已讀是單調前進的，不需要集合。
/// 也不存未讀數：存下來的話每寫一則訊息就要更新房間內所有成員的未讀數，
/// 一次寫入放大成 N 次，而它可以用 room.last_seq - last_read_seq 算出來
model ChatRoomReadRecord {
  roomId String         @map("room_id")
  room   ChatRoomRecord @relation(fields: [roomId], references: [id], onDelete: Cascade)

  memberId String @map("member_id")

  /// 最後讀到的訊息序號。只增不減——客戶端往回捲不代表未讀
  lastReadSeq Int @default(0) @map("last_read_seq")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([roomId, memberId])
  @@map("chat_room_reads")
}

/// 聊天行為稽核的動作類型
///
/// 用 DB enum 而非字串欄位：typo 會產生一個沒有人發現的新類別，
/// 而查詢時只會少一筆——沒有錯誤、沒有徵兆
enum ChatAuditAction {
  ROOM_JOINED
  ROOM_LEFT
  MESSAGE_RETRACTED
  MESSAGE_RETRACT_REJECTED
  MESSAGE_RATE_LIMITED
  REPORT_SUBMITTED
  REPORT_VIEWED
  MESSAGE_REMOVED
  MESSAGE_RESTORED
  MEMBER_SUSPENDED
  MEMBER_REINSTATED

  @@map("chat_audit_action")
}

/// 聊天行為稽核
///
/// **只記「證據會消失」的行為，不記每則訊息。** 判準不是「這件事重不重要」——
/// 送出訊息已經記在 chat_messages（發送者、房間、時間、序號），再寫一筆稽核
/// 只是把同一份中繼資料存兩次，代價是熱路徑多一次寫入與儲存翻倍。
///
/// 真正沒有紀錄的是：離開房間（成員關係列被直接刪除，因此「某人曾在某房間待到某時」
/// 目前完全不可復原）、被限流擋下、撤回被拒——這些行為過去之後不留任何痕跡
model ChatAuditLogRecord {
  id String @id @default(uuid())

  /// 執行動作的成員 ID。不建外鍵：稽核紀錄要能在帳號被刪除後仍然存在
  memberId String @map("member_id")

  action ChatAuditAction

  /// 相關房間；與房間無關的動作為 null
  roomId String? @map("room_id")

  /// 動作的對象成員。檢舉調查要看的是「B 對 A 做過什麼」，
  /// 沒有這個欄位的話之後要補就得回填歷史，而那補不回來
  targetMemberId String? @map("target_member_id")

  /// 動作的對象訊息，例如撤回或嘗試撤回的那一則
  targetMessageId String? @map("target_message_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // (member_id, created_at) 供「這個人的行為時間軸」——檢舉調查的主要查詢
  @@index([memberId, createdAt], map: "idx_chat_audit_member_time")
  @@index([roomId, createdAt], map: "idx_chat_audit_room_time")
  @@map("chat_audit_logs")
}

/// 檢舉的理由分類
enum ChatReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE
  OTHER

  @@map("chat_report_reason")
}

/// 檢舉的處理狀態
///
/// 目前恆為 PENDING——本階段沒有任何東西會改變它。刻意留著是因為後台佇列的
/// 第一個查詢就是「給我所有 PENDING 的」，沒有這個欄位那個查詢要靠「有沒有處置紀錄」
/// 反推，等於逼下一階段先做資料遷移
enum ChatReportStatus {
  PENDING
  REVIEWED
  DISMISSED

  @@map("chat_report_status")
}

/// 訊息檢舉
///
/// 只能檢舉訊息，不能直接檢舉使用者或房間：訊息已帶著發送者與房間，
/// 「被檢舉者是誰」推得出來；反過來推不回去。「這個人持續騷擾」要造多筆檢舉，
/// 而多筆指向同一個人的檢舉本身就是訊號
model ChatReportRecord {
  id String @id @default(uuid())

  /// 提出檢舉的成員 ID
  reporterId String @map("reporter_id")

  /// 被檢舉的訊息。不建外鍵：訊息日後若因保留期限被清理，檢舉仍須可審閱
  targetMessageId String @map("target_message_id")

  /// 被檢舉訊息的發送者。由訊息推導而來，存下來是為了「這個人被檢舉幾次」的查詢
  targetMemberId String @map("target_member_id")

  roomId String @map("room_id")

  reason ChatReportReason

  /// 檢舉人的補充說明，上限 500 字
  description String? @db.VarChar(500)

  /// 被檢舉訊息的內容快照
  ///
  /// **這裡刻意違反「稽核不複製內容」的原則。** 稽核紀錄是行為的索引、內容隨時可取；
  /// 但檢舉指向「當下那句話」，而它在審閱前可能已被撤回或因保留期限被清理。
  /// 沒有快照的話，管理員會看到一則空訊息，而檢舉人明明看到了東西——
  /// 那會讓整個檢舉機制失去可信度。
  ///
  /// 代價是這是第二份內容副本，因此它**適用與訊息本體相同的「不外流」規則**：
  /// 只給後台的 RBAC 路徑，任何前台端點都不得回傳它
  contentSnapshot String @map("content_snapshot") @db.Text

  status ChatReportStatus @default(PENDING)

  /// 審閱時間；未審閱為 null
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)

  /// 審閱的管理員 ID。不建外鍵：稽核性質的欄位要能在帳號被刪除後仍然存在
  reviewedBy String? @map("reviewed_by")

  /// 處理註記。目前是自由文字——沒有可選的處置動作，
  /// 日後有了移除訊息／停權會加 action 欄位，本欄的語意不需要改
  reviewNote String? @map("review_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // 同一人對同一則訊息只能檢舉一次——冪等的唯一保證來源。
  // 不同人檢舉同一則則各自一筆：「幾個人檢舉」本身是優先序訊號
  @@unique([reporterId, targetMessageId], map: "uq_chat_reports_reporter_message")
  @@index([status, createdAt], map: "idx_chat_reports_status_time")
  @@index([targetMemberId], map: "idx_chat_reports_target_member")
  @@map("chat_reports")
}
