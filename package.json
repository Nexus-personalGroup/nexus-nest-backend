{
  "name": "nexus-nest-backend",
  "version": "0.0.1",
  "description": "Realtime chat platform — hexagonal NestJS backend + React admin monorepo",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "docker:up": "docker compose up -d --build --wait",
    "docker:deps": "docker compose up -d --wait postgres redis",
    "docker:init": "docker compose exec api pnpm --filter @app/api db:migrate:deploy && docker compose exec api pnpm --filter @app/api db:seed",
    "docker:logs": "docker compose logs -f api web",
    "docker:renew": "docker compose down && docker volume ls -q --filter name=nexus-nest-backend_node-modules | xargs -r docker volume rm && docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "build": "pnpm --filter @app/api build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "verify:ci": "bash scripts/verify-ci.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter @app/api exec eslint --fix",
    "apps/web/**/*.{ts,tsx}": "pnpm --filter @app/web exec eslint --fix"
  }
}
